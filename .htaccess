# ==============================================================================
# Apache / LiteSpeed Shared Hosting Configuration for XTen National Directory
# Optimized for cPanel / LiteSpeed Web Server
# Multi-Subdomain Support: directory.xten.au, people.xten.au, register.xten.au
# ==============================================================================

# 1. Enable Rewrite Engine & Force HTTPS
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Force HTTPS across all subdomains
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Subdomain Canonical Redirect: register.xten.au -> directory.xten.au
    RewriteCond %{HTTP_HOST} ^(www\.)?register\.xten\.au$ [NC]
    RewriteRule ^(.*)$ https://directory.xten.au/$1 [R=301,L]

    # Redirect trailing slashes if not a directory
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)/$ /$1 [L,R=301]

    # DirectoryIndex: prefer index.php for server-side dynamic SEO injection
    DirectoryIndex index.php index.html

    # Dynamic Trust Badge SVG Endpoints (MAA-20260929-003)
    RewriteRule ^badge/([0-9]{11})\.svg$ badge.php?abn=$1&style=dark [QSA,L]
    RewriteRule ^badge/([0-9]{11})-([a-z]+)\.svg$ badge.php?abn=$1&style=$2 [QSA,L]

    # Clean canonical URLs (MAA-20260913-006 & MAA-20260929-003). Each maps a
    # crawlable path onto index.php for dynamic pre-rendering of <title>,
    # meta descriptions, OpenGraph, Schema.org JSON-LD and noscript fallbacks.
    RewriteRule ^verify/?$ index.php?tool=verify [QSA,L]
    RewriteRule ^verify/([0-9]{11})/?$ index.php?verify=$1 [QSA,L]
    RewriteRule ^abn/([0-9]{11})/?$ index.php?abn=$1 [QSA,L]
    RewriteRule ^entity/([0-9]{11})/?$ index.php?abn=$1 [QSA,L]
    RewriteRule ^location/([A-Za-z]{2,3})/?$ index.php?state=$1 [QSA,L]
    RewriteRule ^location/([A-Za-z]{2,3})/([^/]+)/?$ index.php?state=$1&suburb=$2 [QSA,L]
    RewriteRule ^category/([^/]+)/?$ index.php?category=$1 [QSA,L]

    # Handle Clean URLs (fallback to index.php for client-side routing)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# 2. CORS Headers for Embeddable SVG Trust Badges & QR Codes
<IfModule mod_headers.c>
    # Allow subscriber websites to embed dynamic SVG trust badges and QR seals
    <FilesMatch "\.(svg|png|jpg|jpeg|json)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>

    # Security & Protection Headers
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 3. Gzip / Deflate Compression (LiteSpeed / Apache)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# 4. Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 1 hour"
    # Shortened from 1 month (2026-09-13) — the 30-day cache repeatedly
    # served stale JS after a deploy, including to Claude's own test
    # browser. Revert to a long cache once this site stops changing daily.
    ExpiresByType text/css "access plus 10 minutes"
    ExpiresByType text/javascript "access plus 10 minutes"
    ExpiresByType application/javascript "access plus 10 minutes"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

AddDefaultCharset UTF-8
